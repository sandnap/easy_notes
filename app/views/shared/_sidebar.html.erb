<% if authenticated? %>
<div class="flex flex-col">
  <div class="pbs-3 pbe-2">
    <input type="search" name="q" placeholder="Search notes…" autocomplete="off"
           data-controller="notes-search"
           data-notes-search-url-value="<%= search_path %>"
           data-action="input->notes-search#search"
           class="input">
  </div>

  <div data-controller="dialog">
    <div class="flex">
      <button class="btn btn--primary grow mbe-4"
            data-action="dialog#showModal"
            title="Add Category">
        Add Category
      </button>
    </div>
    <div id="dialog">
      <dialog class="dialog" data-dialog-target="menu" data-action="click->dialog#closeOnClickOutside">
        <%= render "shared/category_form", category: Category.new %>
      </dialog>
    </div>
  </div>

  <%= link_to "Edit Categories", categories_path, class: "btn btn--secondary mbe-8 text-center", title: "Edit Categories" %>

  <nav class="accordion" id="categories" data-controller="menu">
    <div class="categories_list menu__group">
      <%= render partial: "categories/category", collection: @categories %>
    </div>
  </nav>
</div>
<% end %>
